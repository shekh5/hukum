# Copy to .env and fill in. Never commit .env.

# Providers. Set both to "mock" to run with no API keys.
STT_PROVIDER=openai            # openai | mock  (deepgram: not implemented yet)
LLM_PROVIDER=anthropic         # anthropic | mock

# Keys (only the ones for the providers you picked are required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# Models
STT_MODEL=gpt-4o-mini-transcribe
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low                 # low | medium | high | xhigh | max  (higher = smarter but slower)

# Behavior
STT_LANGUAGE=                  # en | hi | empty for auto-detect
SYSTEM_PROMPT="You are a helpful assistant. The user is speaking; their words were transcribed by speech-to-text, so ignore small transcription errors and filler words. Answer clearly and concisely."
MAX_HISTORY_MESSAGES=20

# Server
NODE_ENV=development           # development | production (production hides transcripts in logs)
LOG_LEVEL=info
HOST=127.0.0.1                 # use 0.0.0.0 when deploying
PORT=8787
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MIN=30
REQUEST_TIMEOUT_MS=30000
